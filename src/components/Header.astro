---
---

<header class="site-header">

  <div class="header-inner">

    <a href="/" class="brand">

      <img
        src="/images/compassion-initiative-logo.png"
        alt="Compassion Initiative South Sudan"
        class="logo"
      />

      <div class="brand-name">
        <div class="organization">
          Compassion Initiative
        </div>

        <div class="country">
          South Sudan
        </div>
      </div>

    </a>


    <nav class="navigation">

      <a href="#about">About</a>

      <a href="#programs">Our Work</a>

      <a href="#women">Women</a>

      <a href="#education">Education</a>

      <a href="#humanitarian">Humanitarian</a>

      <a href="#approach">Our Approach</a>

      <a href="#gallery">Gallery</a>

      <a href="#contact" class="get-involved">
        Get Involved
      </a>

    </nav>

  </div>

</header>


<style>

  .site-header {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e7e7e7;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    position: sticky;
    top: 0;
    z-index: 1000;
  }


  .header-inner {
    width: 92%;
    max-width: 1250px;
    margin: 0 auto;

    min-height: 92px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
  }


  .brand {
    display: flex;
    align-items: center;

    gap: 13px;

    text-decoration: none;

    flex-shrink: 0;
  }


  .logo {
    width: 72px;
    height: 72px;

    object-fit: contain;

    display: block;
  }


  .brand-name {
    line-height: 1.15;
  }


  .organization {
    color: #173f5f;

    font-size: 22px;

    font-weight: 700;

    white-space: nowrap;
  }


  .country {
    color: #777777;

    font-size: 13px;

    margin-top: 4px;

    font-weight: 600;

    letter-spacing: 0.5px;
  }


  .navigation {
    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 20px;

    flex-wrap: wrap;
  }


  .navigation a {
    color: #29465b;

    text-decoration: none;

    font-size: 14px;

    font-weight: 600;

    white-space: nowrap;

    transition:
      color 0.25s ease;
  }


  .navigation a:hover {
    color: #c47d15;
  }


  .navigation .get-involved {
    background: #d08a19;

    color: #ffffff;

    padding: 12px 18px;

    border-radius: 5px;
  }


  .navigation .get-involved:hover {
    background: #b36f0d;

    color: #ffffff;
  }


  @media (max-width: 1050px) {

    .header-inner {
      flex-direction: column;

      justify-content: center;

      padding: 15px 0;

      gap: 15px;
    }


    .navigation {
      justify-content: center;

      gap: 14px;
    }

  }


  @media (max-width: 650px) {

    .header-inner {
      width: 94%;
    }


    .logo {
      width: 60px;
      height: 60px;
    }


    .organization {
      font-size: 18px;
    }


    .country {
      font-size: 12px;
    }


    .navigation {
      gap: 10px;
    }


    .navigation a {
      font-size: 12px;
    }


    .navigation .get-involved {
      padding: 9px 12px;
    }

  }

</style>