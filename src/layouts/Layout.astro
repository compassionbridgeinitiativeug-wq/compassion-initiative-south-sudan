---
const title = "Compassion Initiative, South Sudan";
const description =
  "Compassion Initiative, South Sudan is an indigenous, community-led organisation committed to raising hope, restoring dignity and empowering communities.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Essential mobile responsiveness -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <!-- Website information -->
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Prevent mobile browsers from forcing unwanted text sizing -->
    <meta name="format-detection" content="telephone=no" />
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  :global(html) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
    background: #ffffff;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>