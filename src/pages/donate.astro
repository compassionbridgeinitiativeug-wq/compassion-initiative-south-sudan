---
import Header from "../components/Header.astro";
---

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      Donate | Compassion Initiative South Sudan
    </title>

    <meta
      name="description"
      content="Support Compassion Initiative South Sudan through a donation to our official USD organisational bank account."
    />

  </head>


  <body>

    <Header />


    <main>

      <!-- =========================================================
           HERO
      ========================================================== -->

      <section class="donate-hero">

        <div class="hero-overlay"></div>

        <div class="container hero-content">

          <p class="eyebrow">
            SUPPORT OUR WORK
          </p>

          <h1>
            Give hope.
            <span>Build possibilities.</span>
          </h1>

          <p>
            Your support can help Compassion Initiative South Sudan continue
            serving vulnerable children, families and communities and creating
            opportunities for a better future.
          </p>

        </div>

      </section>


      <!-- =========================================================
           INTRODUCTION
      ========================================================== -->

      <section class="intro-section">

        <div class="container intro-grid">

          <div>

            <p class="eyebrow dark">
              MAKE A DIFFERENCE
            </p>

            <h2>
              Every contribution
              <span>can become an opportunity.</span>
            </h2>

          </div>


          <div class="intro-copy">

            <p>
              Compassion Initiative South Sudan works alongside vulnerable
              people and communities with a commitment to dignity, opportunity,
              compassion and hope.
            </p>

            <p>
              Your generosity can help strengthen this work and enable the
              organisation to continue responding to the needs of the people
              and communities it serves.
            </p>

            <p>
              Donations can be made directly to the organisation's USD bank
              account using the official banking details below.
            </p>

          </div>

        </div>

      </section>


      <!-- =========================================================
           BANK DONATION
      ========================================================== -->

      <section class="bank-section">

        <div class="container">

          <div class="section-heading">

            <p class="eyebrow dark">
              BANK TRANSFER
            </p>

            <h2>
              Support Compassion Initiative
              <span>South Sudan.</span>
            </h2>

            <p>
              For donors who would like to support our work by bank transfer,
              please use the official organisational USD account below.
            </p>

          </div>


          <!-- =====================================================
               BANK DETAILS CARD
          ====================================================== -->

          <div class="bank-card">

            <div class="bank-card-header">

              <div>

                <p class="bank-label">
                  USD DONATION ACCOUNT
                </p>

                <h3>
                  Compassion Initiative South Sudan
                </h3>

              </div>


              <div class="currency-badge">
                USD
              </div>

            </div>


            <div class="bank-details">


              <!-- ACCOUNT NAME -->

              <div class="detail-row">

                <span class="detail-label">
                  Account Name
                </span>

                <strong>
                  COMPASSION INITIATIVE SOUTH SUDAN
                </strong>

              </div>


              <!-- BANK -->

              <div class="detail-row">

                <span class="detail-label">
                  Bank
                </span>

                <strong>
                  KCB BANK SOUTH SUDAN LIMITED
                </strong>

              </div>


              <!-- SWIFT -->

              <div class="detail-row">

                <span class="detail-label">
                  SWIFT Code
                </span>

                <strong>
                  KCBLSSJB
                </strong>

              </div>


              <!-- BRANCH CODE -->

              <div class="detail-row">

                <span class="detail-label">
                  Branch Code
                </span>

                <strong>
                  4564
                </strong>

              </div>


              <!-- USD ACCOUNT NUMBER -->

              <div class="detail-row account-row">

                <span class="detail-label">
                  USD Account Number
                </span>

                <strong class="account-number">
                  5591148476
                </strong>

              </div>


            </div>


            <!-- ===================================================
                 THANK YOU MESSAGE
            ==================================================== -->

            <div class="donation-note">

              <strong>
                Thank you for standing with us.
              </strong>

              <p>
                Every act of generosity helps strengthen the work of
                Compassion Initiative South Sudan and the people and
                communities we serve.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- =========================================================
           CLOSING MESSAGE
      ========================================================== -->

      <section class="closing-section">

        <div class="container closing-content">

          <p class="eyebrow">
            TOGETHER
          </p>

          <h2>
            Compassion can become
            <span>something practical.</span>
          </h2>

          <p>
            Thank you for believing that vulnerable children, families and
            communities deserve opportunity, dignity and hope.
          </p>

          <a
            href="/#contact"
            class="contact-button"
          >
            Contact Us
          </a>

        </div>

      </section>

    </main>


    <style>

      /* =========================================================
         GENERAL
      ========================================================== */

      :global(*) {
        box-sizing: border-box;
      }


      :global(html) {
        scroll-behavior: smooth;
      }


      :global(body) {
        margin: 0;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        color: #29465b;

        background: #ffffff;
      }


      .container {
        width: 92%;

        max-width: 1120px;

        margin: 0 auto;
      }


      .eyebrow {
        margin: 0 0 16px;

        color: #e0a020;

        font-size: 0.78rem;

        font-weight: 800;

        letter-spacing: 2.5px;
      }


      .eyebrow.dark {
        color: #c47d15;
      }


      h2 {
        margin: 0 0 25px;

        color: #173f5f;

        font-size:
          clamp(2.2rem, 5vw, 3.7rem);

        line-height: 1.08;

        letter-spacing: -1px;
      }


      h2 span {
        color: #c47d15;
      }


      /* =========================================================
         HERO
      ========================================================== */

      .donate-hero {
        position: relative;

        min-height: 500px;

        display: flex;

        align-items: center;

        overflow: hidden;

        background:
          linear-gradient(
            105deg,
            #173f5f,
            #245f83
          );
      }


      .hero-overlay {
        position: absolute;

        inset: 0;

        background:
          radial-gradient(
            circle at 80% 40%,
            rgba(224,160,32,0.24),
            transparent 32%
          );
      }


      .hero-content {
        position: relative;

        z-index: 2;

        padding: 85px 0;

        color: #ffffff;
      }


      .hero-content h1 {
        max-width: 850px;

        margin: 0 0 27px;

        color: #ffffff;

        font-size:
          clamp(3rem, 7vw, 5.4rem);

        line-height: 0.98;

        letter-spacing: -2px;
      }


      .hero-content h1 span {
        display: block;

        color: #e0a020;
      }


      .hero-content > p:last-child {
        max-width: 760px;

        margin: 0;

        color:
          rgba(255,255,255,0.9);

        font-size: 1.08rem;

        line-height: 1.75;
      }


      /* =========================================================
         INTRODUCTION
      ========================================================== */

      .intro-section {
        padding: 85px 0;

        background: #f7f9fb;
      }


      .intro-grid {
        display: grid;

        grid-template-columns:
          0.9fr 1.1fr;

        gap: 70px;
      }


      .intro-copy {
        color: #526477;

        font-size: 1rem;

        line-height: 1.8;
      }


      .intro-copy p {
        margin: 0 0 18px;
      }


      /* =========================================================
         BANK SECTION
      ========================================================== */

      .bank-section {
        padding: 90px 0;

        background: #ffffff;
      }


      .section-heading {
        max-width: 800px;

        margin-bottom: 42px;
      }


      .section-heading > p:last-child {
        margin: 0;

        color: #526477;

        line-height: 1.75;

        font-size: 1rem;
      }


      /* =========================================================
         BANK CARD
      ========================================================== */

      .bank-card {
        max-width: 850px;

        margin: 0 auto;

        background: #ffffff;

        border: 1px solid #e2e8ee;

        border-radius: 8px;

        overflow: hidden;

        box-shadow:
          0 12px 35px rgba(23,63,95,0.10);
      }


      .bank-card-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        padding: 30px;

        background: #173f5f;

        color: #ffffff;
      }


      .bank-label {
        margin: 0 0 8px;

        color: #e0a020;

        font-size: 0.72rem;

        font-weight: 800;

        letter-spacing: 2px;
      }


      .bank-card-header h3 {
        margin: 0;

        color: #ffffff;

        font-size: 1.35rem;

        line-height: 1.3;
      }


      .currency-badge {
        width: 55px;

        height: 55px;

        flex-shrink: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background: #e0a020;

        color: #173f5f;

        font-weight: 800;

        font-size: 0.85rem;
      }


      /* =========================================================
         BANK DETAILS
      ========================================================== */

      .bank-details {
        padding: 10px 30px 25px;
      }


      .detail-row {
        display: grid;

        grid-template-columns:
          220px 1fr;

        gap: 20px;

        align-items: center;

        padding: 23px 0;

        border-bottom: 1px solid #e8edf1;
      }


      .detail-row:last-child {
        border-bottom: none;
      }


      .detail-label {
        color: #6c7b88;

        font-size: 0.82rem;

        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: 0.8px;
      }


      .detail-row strong {
        color: #173f5f;

        font-size: 1rem;

        line-height: 1.5;

        word-break: break-word;
      }


      /* =========================================================
         ACCOUNT NUMBER HIGHLIGHT
      ========================================================== */

      .account-row {
        background: #f7f9fb;

        margin: 0 -30px;

        padding-left: 30px;

        padding-right: 30px;
      }


      .account-number {
        font-size: 1.25rem !important;

        letter-spacing: 1px;

        color: #c47d15 !important;
      }


      /* =========================================================
         DONATION NOTE
      ========================================================== */

      .donation-note {
        margin: 5px 30px 30px;

        padding: 22px 25px;

        border-left: 4px solid #e0a020;

        background: #f7f9fb;
      }


      .donation-note strong {
        color: #173f5f;

        font-size: 1rem;
      }


      .donation-note p {
        margin: 7px 0 0;

        color: #526477;

        font-size: 0.9rem;

        line-height: 1.65;
      }


      /* =========================================================
         CLOSING
      ========================================================== */

      .closing-section {
        padding: 90px 0;

        background:
          linear-gradient(
            105deg,
            #173f5f,
            #245f83
          );

        text-align: center;

        color: #ffffff;
      }


      .closing-content {
        max-width: 850px;
      }


      .closing-content h2 {
        color: #ffffff;
      }


      .closing-content p:not(.eyebrow) {
        max-width: 700px;

        margin: 0 auto;

        color:
          rgba(255,255,255,0.88);

        line-height: 1.75;
      }


      .contact-button {
        display: inline-block;

        margin-top: 30px;

        padding: 13px 23px;

        border-radius: 5px;

        background: #e0a020;

        color: #173f5f;

        text-decoration: none;

        font-weight: 700;

        transition:
          0.25s ease;
      }


      .contact-button:hover {
        background: #efb43a;

        transform: translateY(-2px);
      }


      /* =========================================================
         TABLET
      ========================================================== */

      @media (max-width: 850px) {

        .intro-grid {
          grid-template-columns: 1fr;

          gap: 35px;
        }


        .detail-row {
          grid-template-columns:
            180px 1fr;
        }

      }


      /* =========================================================
         MOBILE
      ========================================================== */

      @media (max-width: 600px) {

        .donate-hero {
          min-height: 470px;
        }


        .hero-content {
          padding: 70px 0;
        }


        .hero-content h1 {
          font-size: 3rem;
        }


        .intro-section,
        .bank-section {
          padding: 60px 0;
        }


        .closing-section {
          padding: 65px 0;
        }


        .bank-card-header {
          padding: 24px;

          align-items: flex-start;
        }


        .bank-card-header h3 {
          font-size: 1.1rem;
        }


        .currency-badge {
          width: 45px;

          height: 45px;

          font-size: 0.75rem;
        }


        .bank-details {
          padding:
            5px 20px 20px;
        }


        .detail-row {
          grid-template-columns: 1fr;

          gap: 7px;

          padding: 19px 0;
        }


        .account-row {
          margin:
            0 -20px;

          padding-left: 20px;

          padding-right: 20px;
        }


        .account-number {
          font-size: 1.15rem !important;
        }


        .donation-note {
          margin:
            5px 20px 20px;

          padding: 20px;
        }


        h2 {
          font-size: 2.2rem;
        }

      }

    </style>

  </body>

</html>