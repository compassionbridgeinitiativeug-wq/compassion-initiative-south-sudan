---
const organizationName = "Compassion Initiative, South Sudan";
const motto = "Raising Hope. Restoring Dignity. Empowering Communities.";
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Compassion Initiative, South Sudan is an indigenous organisation working alongside vulnerable women, children and communities through education, women's empowerment, livelihoods, community development and humanitarian response."
  />

  <title>
    Compassion Initiative, South Sudan
  </title>


  <style>

    /* =========================================================
       RESET
    ========================================================= */

    :global(*) {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      font-family:
        Arial,
        Helvetica,
        sans-serif;

      color: #243447;

      background: #ffffff;

      line-height: 1.6;
    }

    :global(a) {
      text-decoration: none;
    }


    /* =========================================================
       TOP BAR
    ========================================================= */

    .topbar {

      background: #173f5f;

      color: #ffffff;

      padding: 8px 6%;

      text-align: right;

      font-size: 13px;

      letter-spacing: 0.2px;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .header {

      background: #ffffff;

      padding: 14px 5%;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 25px;

      border-bottom: 1px solid #e8e8e8;

      position: sticky;

      top: 0;

      z-index: 1000;

      box-shadow:
        0 2px 12px rgba(0,0,0,0.05);
    }


    .brand {

      display: flex;

      align-items: center;

      gap: 13px;

      flex-shrink: 0;
    }


    .brand-logo {

      width: 72px;

      height: 72px;

      object-fit: contain;

      display: block;
    }


    .brand-text h1 {

      font-size: 21px;

      line-height: 1.15;

      color: #173f5f;

      margin-bottom: 3px;

      font-weight: 700;
    }


    .brand-text p {

      font-size: 12px;

      color: #777777;

      font-weight: 600;

      letter-spacing: 0.5px;
    }


    nav {

      display: flex;

      align-items: center;

      justify-content: flex-end;

      flex-wrap: wrap;

      gap: 19px;
    }


    nav a {

      color: #29465b;

      font-size: 14px;

      font-weight: 600;

      transition: 0.25s;
    }


    nav a:hover {

      color: #d08a19;
    }


    .nav-button {

      background: #d08a19;

      color: #ffffff !important;

      padding: 11px 17px;

      border-radius: 5px;
    }


    .nav-button:hover {

      background: #b8730f;

      color: #ffffff !important;
    }


    /* =========================================================
       HERO
    ========================================================= */

    .hero {

      min-height: 690px;

      display: flex;

      align-items: center;

      position: relative;

      overflow: hidden;

      background:

        linear-gradient(
          90deg,
          rgba(18,53,79,0.96) 0%,
          rgba(18,53,79,0.88) 45%,
          rgba(18,53,79,0.42) 100%
        ),

        url("/images/south-sudan-02.jpg")
        center center /
        cover no-repeat;
    }


    .hero-content {

      width: 88%;

      max-width: 1200px;

      margin: 0 auto;

      color: #ffffff;

      padding: 100px 0;
    }


    .hero-label {

      display: inline-block;

      border-left:
        4px solid #d9a441;

      padding-left: 12px;

      font-size: 14px;

      font-weight: bold;

      letter-spacing: 1.5px;

      text-transform: uppercase;

      margin-bottom: 22px;

      color: #f5d78f;
    }


    .hero h2 {

      max-width: 850px;

      font-size:
        clamp(42px, 6vw, 72px);

      line-height: 1.08;

      margin-bottom: 24px;

      font-weight: 700;
    }


    .hero h2 span {

      color: #f0c968;
    }


    .hero p {

      max-width: 720px;

      font-size: 20px;

      line-height: 1.7;

      color: #edf4f8;

      margin-bottom: 34px;
    }


    .hero-buttons {

      display: flex;

      flex-wrap: wrap;

      gap: 14px;
    }


    .button {

      display: inline-block;

      padding: 14px 25px;

      border-radius: 5px;

      font-weight: bold;

      font-size: 15px;

      transition: 0.3s;
    }


    .button-primary {

      background: #d08a19;

      color: #ffffff;
    }


    .button-primary:hover {

      background: #b8730f;

      transform:
        translateY(-2px);
    }


    .button-light {

      border:
        1px solid
        rgba(255,255,255,0.7);

      color: #ffffff;
    }


    .button-light:hover {

      background: #ffffff;

      color: #173f5f;
    }


    /* =========================================================
       GENERAL SECTIONS
    ========================================================= */

    section {

      padding:
        90px 6%;
    }


    .section-heading {

      text-align: center;

      max-width: 780px;

      margin:
        0 auto 55px;
    }


    .eyebrow {

      color: #c17c13;

      font-weight: bold;

      font-size: 13px;

      letter-spacing: 1.5px;

      text-transform: uppercase;

      margin-bottom: 10px;
    }


    .section-heading h2 {

      color: #173f5f;

      font-size: 38px;

      line-height: 1.2;

      margin-bottom: 17px;
    }


    .section-heading p {

      color: #667788;

      font-size: 17px;
    }


    /* =========================================================
       ABOUT
    ========================================================= */

    .intro {

      background: #f7f9fa;
    }


    .intro-grid {

      max-width: 1200px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 55px;

      align-items: center;
    }


    .intro-text h3 {

      color: #173f5f;

      font-size: 32px;

      margin-bottom: 20px;

      line-height: 1.25;
    }


    .intro-text p {

      color: #596b7a;

      margin-bottom: 18px;

      font-size: 16px;
    }


    .intro-photo {

      width: 100%;

      height: 430px;

      border-radius: 10px;

      overflow: hidden;

      box-shadow:
        0 15px 40px
        rgba(0,0,0,0.10);
    }


    .intro-photo img {

      width: 100%;

      height: 100%;

      object-fit: cover;

      display: block;
    }


    .quote-box {

      border-left:
        5px solid #d9a441;

      background: #ffffff;

      padding: 28px;

      box-shadow:
        0 8px 30px
        rgba(0,0,0,0.06);

      margin-top: 25px;
    }


    .quote-box p {

      color: #173f5f;

      font-size: 21px;

      font-weight: 600;

      line-height: 1.5;

      margin: 0;
    }


    /* =========================================================
       DIRECTOR
    ========================================================= */

    .director {

      background: #ffffff;
    }


    .director-grid {

      max-width: 1150px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        380px 1fr;

      gap: 60px;

      align-items: center;
    }


    .director-photo {

      width: 100%;

      height: 480px;

      border-radius: 10px;

      overflow: hidden;

      background: #eef2f4;

      box-shadow:
        0 15px 40px
        rgba(0,0,0,0.12);
    }


    .director-photo img {

      width: 100%;

      height: 100%;

      object-fit: cover;

      object-position: center;

      display: block;
    }


    .director-content h2 {

      color: #173f5f;

      font-size: 38px;

      line-height: 1.2;

      margin-bottom: 22px;
    }


    .director-content p {

      color: #596b7a;

      font-size: 16px;

      margin-bottom: 17px;
    }


    .director-signature {

      margin-top: 25px;

      padding-top: 20px;

      border-top:
        1px solid #e4e9ec;
    }


    .director-signature strong {

      display: block;

      color: #173f5f;

      font-size: 19px;
    }


    .director-signature span {

      color: #c17c13;

      font-size: 14px;

      font-weight: bold;
    }


    /* =========================================================
       PROGRAMS
    ========================================================= */

    .programs {

      background: #ffffff;
    }


    .program-grid {

      max-width: 1200px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 25px;
    }


    .program-card {

      background: #ffffff;

      border:
        1px solid #e7ecef;

      border-radius: 8px;

      padding: 34px;

      transition: 0.3s;

      box-shadow:
        0 5px 20px
        rgba(0,0,0,0.04);
    }


    .program-card:hover {

      transform:
        translateY(-5px);

      box-shadow:
        0 15px 35px
        rgba(0,0,0,0.08);
    }


    .program-number {

      width: 45px;

      height: 45px;

      border-radius: 50%;

      background: #f3e2b7;

      color: #173f5f;

      display: flex;

      align-items: center;

      justify-content: center;

      font-weight: bold;

      margin-bottom: 20px;
    }


    .program-card h3 {

      color: #173f5f;

      font-size: 22px;

      margin-bottom: 12px;
    }


    .program-card p {

      color: #667788;

      font-size: 15px;
    }


    /* =========================================================
       EDUCATION
    ========================================================= */

    .education {

      background: #f7f9fa;
    }


    .education-grid {

      max-width: 1200px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 55px;

      align-items: center;
    }


    .education-content h2 {

      color: #173f5f;

      font-size: 38px;

      line-height: 1.2;

      margin-bottom: 20px;
    }


    .education-content p {

      color: #596b7a;

      font-size: 16px;

      margin-bottom: 18px;
    }


    .education-list {

      list-style: none;

      margin-top: 20px;
    }


    .education-list li {

      position: relative;

      padding-left: 28px;

      margin-bottom: 12px;

      color: #596b7a;
    }


    .education-list li::before {

      content: "✓";

      position: absolute;

      left: 0;

      color: #c17c13;

      font-weight: bold;
    }


    .education-photos {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 15px;
    }


    .education-photo {

      height: 300px;

      border-radius: 9px;

      overflow: hidden;

      box-shadow:
        0 10px 30px
        rgba(0,0,0,0.08);
    }


    .education-photo img {

      width: 100%;

      height: 100%;

      object-fit: cover;

      display: block;
    }


    /* =========================================================
       WOMEN
    ========================================================= */

    .women {

      background: #173f5f;

      color: #ffffff;
    }


    .women-grid {

      max-width: 1200px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        1.05fr 0.95fr;

      gap: 55px;

      align-items: center;
    }


    .women-content .eyebrow {

      color: #f0c968;
    }


    .women-content h2 {

      font-size: 40px;

      line-height: 1.2;

      margin-bottom: 22px;
    }


    .women-content p {

      color: #dce8ef;

      margin-bottom: 18px;

      font-size: 16px;
    }


    .women-list {

      margin-top: 25px;

      list-style: none;
    }


    .women-list li {

      margin-bottom: 13px;

      padding-left: 25px;

      position: relative;

      color: #edf4f8;
    }


    .women-list li::before {

      content: "✓";

      position: absolute;

      left: 0;

      color: #f0c968;

      font-weight: bold;
    }


    .women-photos {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 14px;
    }


    .women-photo {

      height: 230px;

      border-radius: 8px;

      overflow: hidden;
    }


    .women-photo.large {

      grid-column:
        span 2;

      height: 300px;
    }


    .women-photo img {

      width: 100%;

      height: 100%;

      object-fit: cover;

      display: block;
    }


    .women-highlight {

      background:
        rgba(255,255,255,0.09);

      border:
        1px solid
        rgba(255,255,255,0.15);

      padding: 30px;

      border-radius: 8px;

      margin-top: 25px;
    }


    .women-highlight h3 {

      color: #f0c968;

      font-size: 26px;

      margin-bottom: 18px;
    }


    .women-highlight p {

      color: #e0ebf1;

      font-size: 17px;
    }


    /* =========================================================
       HUMANITARIAN
    ========================================================= */

    .humanitarian {

      background: #f7f5ef;
    }


    .humanitarian-grid {

      max-width: 1200px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 55px;

      align-items: center;
    }


    .humanitarian-box {

      background: #ffffff;

      padding: 38px;

      border-radius: 8px;

      border-top:
        5px solid #d08a19;

      box-shadow:
        0 8px 25px
        rgba(0,0,0,0.06);
    }


    .humanitarian-box h3 {

      color: #173f5f;

      font-size: 28px;

      margin-bottom: 16px;
    }


    .humanitarian-box p {

      color: #617180;

      margin-bottom: 18px;
    }


    .humanitarian-photo {

      width: 100%;

      height: 450px;

      border-radius: 10px;

      overflow: hidden;

      box-shadow:
        0 15px 40px
        rgba(0,0,0,0.10);
    }


    .humanitarian-photo img {

      width: 100%;

      height: 100%;

      object-fit: cover;

      display: block;
    }


    /* =========================================================
       APPROACH
    ========================================================= */

    .approach {

      background: #ffffff;
    }


    .approach-flow {

      max-width: 1100px;

      margin: 0 auto;

      display: flex;

      justify-content: center;

      align-items: center;

      flex-wrap: wrap;

      gap: 10px;
    }


    .approach-step {

      background: #f2f6f8;

      color: #173f5f;

      padding: 17px 22px;

      border-radius: 5px;

      font-weight: bold;

      border-bottom:
        3px solid #d9a441;
    }


    .arrow {

      color: #c58a27;

      font-weight: bold;

      font-size: 20px;
    }


    /* =========================================================
       VALUES
    ========================================================= */

    .values {

      background: #f7f9fa;
    }


    .values-grid {

      max-width: 1100px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 18px;
    }


    .value {

      background: #ffffff;

      padding: 25px 20px;

      text-align: center;

      border-radius: 7px;

      border:
        1px solid #e7ecef;
    }


    .value h3 {

      color: #173f5f;

      font-size: 18px;

      margin-bottom: 8px;
    }


    .value p {

      color: #758391;

      font-size: 13px;
    }


    /* =========================================================
       GALLERY
    ========================================================= */

    .gallery {

      background: #ffffff;
    }


    .gallery-grid {

      max-width: 1200px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 16px;
    }


    .gallery-item {

      height: 270px;

      border-radius: 8px;

      overflow: hidden;

      position: relative;

      background: #e8edf0;
    }


    .gallery-item.tall {

      height: 390px;
    }


    .gallery-item img {

      width: 100%;

      height: 100%;

      object-fit: cover;

      display: block;

      transition:
        transform 0.5s ease;
    }


    .gallery-item:hover img {

      transform:
        scale(1.04);
    }


    .gallery-caption {

      position: absolute;

      left: 0;

      right: 0;

      bottom: 0;

      padding:
        35px 18px 15px;

      color: #ffffff;

      font-weight: bold;

      font-size: 14px;

      background:
        linear-gradient(
          transparent,
          rgba(0,0,0,0.75)
        );
    }


    /* =========================================================
       GET INVOLVED
    ========================================================= */

    .cta {

      background:
        linear-gradient(
          135deg,
          #173f5f,
          #245b80
        );

      text-align: center;

      color: #ffffff;

      padding: 85px 6%;

      position: relative;

      overflow: hidden;
    }


    .cta-inner {

      max-width: 900px;

      margin: 0 auto;

      position: relative;

      z-index: 1;
    }


    .cta-eyebrow {

      color: #f0c968;

      font-size: 13px;

      font-weight: bold;

      letter-spacing: 1.8px;

      text-transform: uppercase;

      margin-bottom: 12px;
    }


    .cta h2 {

      font-size:
        clamp(32px, 5vw, 46px);

      line-height: 1.2;

      margin-bottom: 18px;
    }


    .cta p {

      max-width: 760px;

      margin:
        0 auto 30px;

      color: #e0ebf1;

      font-size: 17px;

      line-height: 1.75;
    }


    .contact-grid {

      max-width: 900px;

      margin:
        35px auto 0;

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 15px;
    }


    .contact-card {

      background:
        rgba(255,255,255,0.09);

      border:
        1px solid
        rgba(255,255,255,0.16);

      border-radius: 7px;

      padding: 23px 15px;
    }


    .contact-card strong {

      display: block;

      color: #f0c968;

      margin-bottom: 8px;
    }


    .contact-card a {

      color: #ffffff;

      font-size: 14px;

      word-break: break-word;
    }


    .contact-card a:hover {

      color: #f0c968;
    }


    /* =========================================================
       DONATE
    ========================================================= */

    .donate-box {

      max-width: 850px;

      margin:
        35px auto 0;

      padding: 30px;

      border:
        1px solid
        rgba(255,255,255,0.20);

      border-radius: 8px;

      background:
        rgba(255,255,255,0.07);
    }


    .donate-box h3 {

      color: #f0c968;

      font-size: 27px;

      margin-bottom: 10px;
    }


    .donate-box p {

      margin: 0;

      color: #e0ebf1;
    }


    /* =========================================================
       FOOTER
    ========================================================= */

    footer {

      background: #102f46;

      color: #ffffff;

      padding:
        55px 6% 25px;
    }


    .footer-grid {

      max-width: 1150px;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        1.5fr 1fr 1fr;

      gap: 50px;
    }


    footer h3 {

      margin-bottom: 15px;

      color: #f0c968;
    }


    footer p,
    footer li {

      color: #c9d6df;

      font-size: 14px;
    }


    footer ul {

      list-style: none;
    }


    footer li {

      margin-bottom: 8px;
    }


    footer a {

      color: #c9d6df;

      overflow-wrap: anywhere;

      word-break: break-word;
    }


    footer a:hover {

      color: #f0c968;
    }


    .footer-bottom {

      max-width: 1150px;

      margin:
        40px auto 0;

      padding-top: 20px;

      border-top:
        1px solid
        rgba(255,255,255,0.15);

      text-align: center;

      color: #9fb1be;

      font-size: 13px;
    }


    /* =========================================================
       TABLET
    ========================================================= */

    @media (max-width: 900px) {

      .header {

        flex-direction: column;

        align-items: flex-start;
      }


      nav {

        width: 100%;

        justify-content: flex-start;

        gap: 14px;
      }


      .intro-grid,
      .director-grid,
      .education-grid,
      .women-grid,
      .humanitarian-grid {

        grid-template-columns: 1fr;
      }


      .director-photo {

        max-width: 500px;

        margin: 0 auto;
      }


      .values-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }


      .gallery-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }


      .contact-grid {

        grid-template-columns:
          1fr;
      }


      .hero {

        min-height: 600px;
      }


      .hero h2 {

        font-size: 48px;
      }

    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 600px) {

      .topbar {

        text-align: center;

        font-size: 11px;
      }


      .header {

        padding:
          12px 5%;
      }


      .brand-logo {

        width: 60px;

        height: 60px;
      }


      .brand-text h1 {

        font-size: 18px;
      }


      nav {

        gap: 10px;
      }


      nav a {

        font-size: 12px;
      }


      .nav-button {

        padding:
          9px 13px;
      }


      section {

        padding:
          65px 5%;
      }


      .hero {

        min-height: 650px;

        background-position:
          62% center;
      }


      .hero-content {

        width: 90%;

        padding:
          65px 0;
      }


      .hero h2 {

        font-size: 40px;
      }


      .hero p {

        font-size: 17px;
      }


      .button {

        padding:
          13px 20px;
      }


      .intro-text h3 {

        font-size: 28px;
      }


      .intro-photo {

        height: 300px;
      }


      .director-photo {

        height: 390px;
      }


      .director-content h2 {

        font-size: 32px;
      }


      .education-content h2 {

        font-size: 32px;
      }


      .education-photos {

        grid-template-columns:
          1fr;
      }


      .education-photo {

        height: 280px;
      }


      .program-grid {

        grid-template-columns:
          1fr;
      }


      .values-grid {

        grid-template-columns:
          1fr;
      }


      .gallery-grid {

        grid-template-columns:
          1fr;
      }


      .gallery-item,
      .gallery-item.tall {

        height: 280px;
      }


      .women-content h2 {

        font-size: 32px;
      }


      .women-photos {

        grid-template-columns:
          1fr;
      }


      .women-photo,
      .women-photo.large {

        grid-column:
          span 1;

        height: 280px;
      }


